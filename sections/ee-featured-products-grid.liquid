{%- assign uid = section.id -%}
{%- assign settings = section.settings -%}
{%- assign blocks = section.blocks -%}


{% comment %} Featured Products Grid Section {% endcomment %}
 <section id="ee-featured-products-{{ uid }}" class="ee-featured-products color-{{ settings.color_scheme }} section-{{ uid }}-padding">
    <div class="ee-container">
        {%- if settings.section_title !=blank -%}
            <h2 class="ee-section__title">{{ settings.section_title }}</h2>
        {%- endif -%}

        <div class="ee-featured-products__grid">
            {%- for block in blocks -%}
                {%- assign _product = block.settings.product -%}
                {%- assign _position_x = block.settings.position_x -%}
                {%- assign _position_y = block.settings.position_y -%}
                {% render 'ee-product-card', card_product: _product, positionX: _position_x, positionY: _position_y, block_attrs: block.shopify_attributes %}
            {%- endfor -%}
        </div>
    </div>

    {% comment %} POPUP {% endcomment %}
    <div class="ee-product-popup"
        id="ee-popup--{{ uid }}"
        role="dialog"
        aria-modal="true"
        aria-labelledby="PopupTitle-{{ uid }}"
        ee-data-popup
        hidden
        >
        {% comment %} OVERLAY {% endcomment %}
        <div class="ee-popup__overlay"><span></span></div>

        {% comment %} POPUP CONTENT {% endcomment %}
        <div class="ee-popup__content">
            <button type="button" class="ee-popup__close">
                <svg width="17" height="17" viewBox="0 0 17 17" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M4.24219 4.24279L12.7275 12.7281" stroke="black" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="round"/>
                    <path d="M4.24219 12.7278L12.7275 4.24249" stroke="black" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="round"/>
                </svg>
            </button>
            
            <div class="ee-popup__info">
                <img src="" alt="" class="ee-popup__image" width="120" height="140"/>
                <div class="ee-popup__text">
                    <h3 class="ee-popup__title"></h3>
                    <p class="ee-popup__price"></p>
                    <div class="ee-popup__description"></div>
                </div>
            </div>
            <div class="ee-popup__options"></div>
            
            <p class="ee-popup__error" hidden></p>

            <div class="ee-popup__actions">
                <button type="button" class="ee-btn ee-popup__add-to-cart">
                    Add to Cart
                    <svg width="36" height="12" viewBox="0 0 36 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M0.75 4.77295L9.20657e-08 4.77295L-9.20657e-08 6.27295L0.75 6.27295L0.75 4.77295ZM34.9798 6.05328C35.2727 5.76039 35.2727 5.28551 34.9798 4.99262L30.2068 0.21965C29.9139 -0.0732432 29.4391 -0.0732433 29.1462 0.21965C28.8533 0.512544 28.8533 0.987417 29.1462 1.28031L33.3888 5.52295L29.1462 9.76559C28.8533 10.0585 28.8533 10.5334 29.1462 10.8263C29.4391 11.1191 29.9139 11.1191 30.2068 10.8263L34.9798 6.05328ZM0.75 6.27295L34.4495 6.27295L34.4495 4.77295L0.75 4.77295L0.75 6.27295Z" fill="white"/>
                    </svg>
                </button>
            </div>
        </div>
    </div>
 </section>

 {% style %}
    .section-{{ uid }}-padding {
        --padding-top: {{ section.settings.vertical_padding_desktop }}px;
        --padding-bottom: {{ section.settings.vertical_padding_desktop }}px;
        padding-block: var(--padding-top) var(--padding-bottom);
    }

    .ee-section__title {
        font-weight: 400;
        font-family: var(--ff-secondary);
        line-height: 1.2;
        font-size: clamp(1.5rem, 1.236rem + 1.127vw, 2.25rem);
        margin-bottom: 30px;
    }

    .ee-featured-products__grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

    .ee-featured-products__item {
        aspect-ratio: 1;
        display: block;
        box-sizing: border-box;
        position: relative;
    }

    .ee-featured-products__item img {
        height: 100%;
        width: 100%;
        object-fit: cover;
    }

    .ee-featured-products__pointer {
        position: absolute;
        cursor: pointer;
        z-index: 1;
        top: var(--ee-pointer-position-y);
        left: var(--ee-pointer-position-x);
        transition: all 0.2s ease-in-out;
        box-shadow: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        outline: none;
        padding: 0;
        box-sizing: border-box;
        background: transparent;
        border: 0;
    }


    /* POPUP DESIGN */
    .ee-product-popup{
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        align-items: center;
        justify-content: center;
        z-index: 9999;
        display: flex;

        &[hidden]{
            display: none;
        }
    }
    .ee-popup__overlay {
        position: absolute;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        z-index: -1;
    }
    .ee-popup__content {
        display: flex;
        flex-direction: column;
        max-width: 100%;
        width: 360px;
        background: #fff;
        padding: 15px;
        padding-top: 40px;
        position: relative;
    }

    button.ee-popup__close {
        position: absolute;
        top: 15px;
        right: 15px;
        box-sizing: border-box;
        outline: none;
        border: 0;
        background: transparent;
        padding: 0;
        box-shadow: none;
        cursor: pointer;
    }

    .ee-popup__info {
        display: grid;
        grid-template-columns: 1.15fr 1.5fr;
        gap: 15px;
    }

    .ee-popup__image {aspect-ratio: 3 / 4;object-fit: cover;object-position: center;}
    .ee-popup__title {
        font-size: 16px;
        line-height: 1.2;
        font-weight: 300;
        letter-spacing: 0;
        margin: 0;
    }

    .ee-popup__price {
        margin: 0;
        font-size: 16px;
        line-height: 1.2;
        font-weight: 400;
        font-family: var(--ff-secondary);
    }

    .ee-popup__text {
        display: flex;
        flex-direction: column;
        gap: 15px;
        justify-content: center;
    }

    .ee-popup__description {
        font-size: 14px;
        line-height: 1.2;
        letter-spacing: -0.01em;
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
    }

    .ee-popup__options {
        display: flex;
        flex-direction: column-reverse;
        gap: 12px;
        margin-top: 15px;
    }
    .ee-option-label {
        font-size: 14px;
        font-weight: 400;
        line-height: 1.4;
        margin-bottom: 6px;
    }
    .ee-option-select {
        border: 1px solid;
        width: 100%;
        border-radius: 0;
        padding: 4px 14px;
        padding-right: 40px;
        -webkit-appearance: none;
        appearance: none;
        font-size: 14px;
        height: 40px;
        outline: none;
        box-shadow: none;
        background: url("data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTUiIGhlaWdodD0iOSIgdmlld0JveD0iMCAwIDE1IDkiIGZpbGw9Im5vbmUiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+CjxwYXRoIGQ9Ik0xLjA2MDY3IDEuMDYwNjdMNy4wNjA2NyA3LjA2MDY3TDEzLjA2MDcgMS4wNjA2NyIgc3Ryb2tlPSJibGFjayIgc3Ryb2tlLXdpZHRoPSIxLjUiIHN0cm9rZS1saW5lY2FwPSJzcXVhcmUiLz4KPC9zdmc+Cg==");
        background-position: calc(100% - 15px) 17px;
        background-repeat: no-repeat;
        background-size: 13px;
    }
    .ee-option-select::before {
        content: '';
        width: 1px;
        height: 100%;
        position: absolute;
    }

    .ee-option-radios {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0px;
    }

    label.ee-option-radio {
        border: 1px solid #000;
        height: 40px;
        border-radius: 0px;
        padding-inline-start: 20px;
        position: relative;
    }

    label.ee-option-radio::before {
        content: "";
        width: 8px;
        height: 100%;
        background-color: var(--color-name);
        position: absolute;
        left: 0;
        top: 0;
        z-index: 2;
        border-right: 1px solid #000;
    }

    label.ee-option-radio input[type=radio] {display: none;}

    label.ee-option-radio:has(input[type=radio]:checked) {
        background: #000;
        color: #fff;
        border: #000;
    }

    .ee-popup__add-to-cart {
        width: 100%;
        margin-top: 30px;
    }

    @media (max-width: 768px) {
        .section-{{ uid }}-padding {
            --padding-top: {{ section.settings.vertical_padding_mobile }}px;
            --padding-bottom: {{ section.settings.vertical_padding_mobile }}px;
        }
        .ee-featured-products__grid{
            grid-template-columns: repeat(2, 1fr);
            gap: 5px;
        }
    }
 {% endstyle %}



<script>
    ( function (){
        document.querySelectorAll('.ee-featured-products').forEach(initSection);
        
        function initSection(section) {
            var gridItem = section.querySelectorAll('.ee-featured-products__item');
            var popupEl = section.querySelector('.ee-product-popup');
            if (!gridItem || !popupEl) return;

            var el ={
                image: popupEl.querySelector('.ee-popup__image'),
                name: popupEl.querySelector('.ee-popup__title'),
                price: popupEl.querySelector('.ee-popup__price'),
                description: popupEl.querySelector('.ee-popup__description'),
                options: popupEl.querySelector('.ee-popup__options'),
                error: popupEl.querySelector('.ee-popup__error'),
                cart_button: popupEl.querySelector('.ee-popup__add-to-cart')
            }
            var state ={
                product: null,
                selected: {},
                lastTrigger: null
            }

            gridItem.forEach(function(cardItem) {
                var quickViewBtn = cardItem.querySelector('.ee-featured-products__pointer');
                if (!quickViewBtn) return;
                quickViewBtn.addEventListener('click', function() {
                    // alert('Quick view clicked');
                    var json = cardItem.querySelector('.ee-product-data-json');
                    // console.log("JSON", json);
                    if (!json) return;
                    // alert("CLICKED");
                    var product;
                    try{
                        product = JSON.parse(json.textContent);
                        // console.log("Parsed product data:", product);
                    } catch (e) {
                        console.error("Error parsing product data:", e);
                    }
                    state.product = product;
                    state.lastTrigger = quickViewBtn;
                    openPopup(product);
                });
            });

            function openPopup(product){
                // TODO: Implement popup logic
                console.log("Opening popup for product:", product);
                state.product = product;
                state.selected = {};

                // console.log("PRODUCT", product);

                var img = product.image || '';
                if (el.image) el.image.src = img;
                if (el.name) el.name.textContent = product.title;
                // if (el.price) el.price.textContent = product.price;
                if (el.description) el.description.innerHTML = product.description;               
                
                // First Variant Item Selected 
                var firstVariant = product.variants && product.variants[0];
                if (firstVariant && product.options){
                    // product.options.forEach(function(option, index){
                    //     // state.selected['option' + (index + 1)] = firstVariant['option' + (index + 1)];
                    //     // console.log("Option", option, index);
                    //     state.selected[option] = firstVariant.options[index];
                    //     console.log("SELECTED", state.selected[option]);
                    // });
                    product.options.forEach(function(option, index){
                        state.selected[option.name] = firstVariant.options[index];
                    });
                }

                renderOptions(product);
                updatePrice();
                showPopup();
            }

            function getSelectedVariant() {
                var product = state.product;

                if (!product || !product.options) return null;

                return product.variants.find(function(variant) {

                    return variant.options.every(function(optionValue, index) {

                        return optionValue === state.selected[product.options[index].name]

                    });

                }) || null;
            }

            function updatePrice(){
                var variant = getSelectedVariant();
                var product = state.product;
                var price = variant ? variant.price : product.price;
                el.price.textContent = new Intl.NumberFormat("de-DE", { style: "currency", currency: "EUR" }).format(price / 100);
                console.log("PRICE UPDATED", state.selected);
            }

            function renderOptions(product){
                el.options.innerHTML = ''; // Clear existing content

                product.options.forEach(function(option, optionIndex) {
                    const wrapper = document.createElement('div');
                    wrapper.className = 'ee-option-picker';

                    const label = document.createElement('div');
                    label.className = 'ee-option-label';
                    label.textContent = option.name;
                    wrapper.appendChild(label);

                    if (option.name === 'Color') {

                        console.log("Color", state);


                        // Radio
                        const radiosWrapper = document.createElement('div');
                        radiosWrapper.className = 'ee-option-radios';
                        radiosWrapper.dataset.optionIndex = optionIndex;

                        option.values.forEach(function(value, valueIndex) {
                        const id = `option-${optionIndex}-value-${valueIndex}`;

                        const radioWrapper = document.createElement('label');
                        radioWrapper.className = 'ee-option-radio';
                        radioWrapper.style.setProperty('--color-name', value.name);

                        const radio = document.createElement('input');
                        radio.type = 'radio';
                        radio.name = `options[${optionIndex}]`;
                        radio.value = value.id; // or value.name if your values don't have ids yet
                        radio.dataset.optionIndex = optionIndex;
                        radio.id = id;
                        const span = document.createElement('span');
                        span.textContent = value.name;
                        if (state.selected[option.name] === value.name) radio.checked = true;


                        radio.addEventListener('change', function() {
                            state.selected[option.name] = value.name;
                            updatePrice();                            
                        });


                        radioWrapper.appendChild(radio);
                        radioWrapper.appendChild(span);

                        radiosWrapper.appendChild(radioWrapper);
                        });

                        wrapper.appendChild(radiosWrapper);
                    } else {
                        // Dropdown
                        const select = document.createElement('select');
                        select.className = 'ee-option-select';
                        select.dataset.optionIndex = optionIndex;
                        select.name = `options[${optionIndex}]`;

                        const placeholder = document.createElement('option');
                        placeholder.value = '';
                        placeholder.textContent = 'Choose your size';
                        select.appendChild(placeholder);

                        option.values.forEach(function(value) {
                            const optEl = document.createElement('option');
                            optEl.value = value.name;
                            optEl.textContent = value.name;
                            if (state.selected[option.name] === value.name) optEl.selected = true;
                            select.appendChild(optEl);
                        });
                        
                        select.addEventListener('change', function() {
                            state.selected[option.name] = this.value;
                            console.log('Selected:', state.selected);
                            updatePrice();
                        });
                        wrapper.appendChild(select);
                    }

                    el.options.appendChild(wrapper);
                });

            }

            function showPopup(){
                popupEl.hidden = false;
                document.body.style.overflow = 'hidden';


                // CLOSE BUTTON
                var closeBtn = popupEl.querySelectorAll('.ee-popup__overlay, .ee-popup__close');
                closeBtn.forEach(function(btn) {
                    btn.addEventListener('click', function() {
                        closePopup();
                    });
                });

                // ESC KEY TO CLOSE
                document.addEventListener('keydown', function(e) {
                    if (e.key === 'Escape') {
                        closePopup();
                    }
                });
            }

            function closePopup(){
                console.log("Closing popup");
                popupEl.hidden = true;
                document.body.style.overflow = '';
            }

            // ADD TO CART BUTTON 
            function hideError(){
                el.error.textContent = '';
                el.error.hidden = true;
            }
            function showError(message){
                el.error.textContent = message;
                el.error.hidden = false;
            }
            el.cart_button.addEventListener('click', function (){
                hideError();
                var variant = getSelectedVariant();
                console.log("VARIANT", variant);
                if (!variant) showError('Please select a variant');
                if (!variant.available) showError('Product is out of stock');
                addToCart(variant);
            });


            function setLoading(on){
                el.cart_button.disabled = on;
                el.cart_button.innerHTML = on ? `
                    <span>ADDING</span>
                ` : `
                    <span>ADD TO CART</span>
                    <svg width="36" height="12" viewBox="0 0 36 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M0.75 4.77295L9.20657e-08 4.77295L-9.20657e-08 6.27295L0.75 6.27295L0.75 4.77295ZM34.9798 6.05328C35.2727 5.76039 35.2727 5.28551 34.9798 4.99262L30.2068 0.21965C29.9139 -0.0732432 29.4391 -0.0732433 29.1462 0.21965C28.8533 0.512544 28.8533 0.987417 29.1462 1.28031L33.3888 5.52295L29.1462 9.76559C28.8533 10.0585 28.8533 10.5334 29.1462 10.8263C29.4391 11.1191 29.9139 11.1191 30.2068 10.8263L34.9798 6.05328ZM0.75 6.27295L34.4495 6.27295L34.4495 4.77295L0.75 4.77295L0.75 6.27295Z" fill="white"/>
                    </svg>
                `                
            }

            function addToCart(variant) {
                setLoading(true);
                fetch('/cart/add.js', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        items: [{
                            id: variant.id,
                            quantity: 1
                        }]
                    })
                })
                .then(function (res){
                    if (!res.ok) return res.json().then(function (errorData) {
                        throw new Error(errorData.description || 'Failed to add product to cart');
                    });
                    return res.json();
                })
                .then(function (data){
                    alert("Product added to cart");
                    closePopup();
                })
                .catch(function (error){
                    showError(error.message);
                    closePopup();
                })
                .finally(function (){
                    setLoading(false);
                });
            }
        }
    })();
</script>


{% schema %}
{
    "name": "EE Featured Products",
    "tag": "section",
    "class": "ee-featured-products-section",
    "disabled_on": {
        "groups": ["header", "footer"]
    },
    "blocks": [
        {
            "type": "product",
            "name": "product",
            "settings": [
                {
                    "type": "product",
                    "id": "product",
                    "label": "Select Product"
                },
                {
                    "type": "header",
                    "content": "Pointer Position"
                },
                {
                    "type": "range",
                    "id": "position_x",
                    "label": "Pointer X Position",
                    "min": 0,
                    "max": 100,
                    "step": 1,
                    "unit": "%",
                    "default": 50
                },
                {
                    "type": "range",
                    "id": "position_y",
                    "label": "Pointer Y Position",
                    "min": 0,
                    "max": 100,
                    "step": 1,
                    "unit": "%",
                    "default": 50
                }
            ]
        }
    ],
    "settings": [
        {
            "type": "header",
            "content": "General"
        },
        {
            "type": "inline_richtext",
            "id": "section_title",
            "label": "Section Title",
            "default": "Tisso vison in the wild"
        },
        {
            "type": "header",
            "content": "Appearance"
        },
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "Color scheme",
            "default": "scheme-1"
        },        
        {
            "type": "header",
            "content": "Spacing"
        },
        {
            "type": "range",
            "id": "vertical_padding_desktop",
            "label": "Vertical padding (Desktop)",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "default": 10
        },
        {
            "type": "range",
            "id": "vertical_padding_mobile",
            "label": "Vertical padding (Mobile)",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "default": 20
        }
    ],
    "presets": [
        {
            "name": "EE Featured Products",
            "settings": {
                "color_scheme": "scheme-1",
                "vertical_padding_desktop": 90,
                "vertical_padding_mobile": 40,
                "section_title": "Tisso vison in the wild"
            }
        }
    ]
}
{% endschema %}